# MagicChecker Traffic Gate Configuration
# ---------------------------------------
# MAGICCHECKER_CAMPAIGN_ID - The MagicChecker campaign ID to use.
#   Default: 813eda39604914d0f4b87bc90c9d87a5 (bound to iptvnord.site)
# OFFER_URL - When MagicChecker redirect points back at this host, visitors are
#   redirected here instead of the store. Set to the offer site URL, e.g.
#   https://www.iptvnord4k.com
# SAFE_URL - When a visitor is banned by MagicChecker OR when the campaign's
#   redirect URL points back at this store AND OFFER_URL is not configured,
#   visitors are redirected to this safe page instead. Set to any URL, e.g.
#   https://example.com/safe-page

MAGICCHECKER_CAMPAIGN_ID=
OFFER_URL=
SAFE_URL=https://example.com/safe
# Local traffic classifier (no MagicChecker call needed for these rules)
# ---------------------------------------------------------------------
# TRAFFIC_LOCAL_FILTER=off        disable the classifier entirely
# TRAFFIC_COUNTRY_ALLOW=US,CA,GB  allowlist — any other country gets the white page
# TRAFFIC_COUNTRY_BLOCK=RU,CN     blocklist — these countries get the white page
# TRAFFIC_ASN_BLOCK=14618,16509   blocked ASNs
#   NOTE: Vercel sends x-vercel-ip-country but NO ASN header, so ASN rules only
#   fire when a proxy in front adds cf-asn / x-client-asn / x-vercel-ip-as-number.
TRAFFIC_LOCAL_FILTER=
TRAFFIC_COUNTRY_ALLOW=
TRAFFIC_COUNTRY_BLOCK=
TRAFFIC_ASN_BLOCK=
# TRAFFIC_DEBUG=1  one structured log line per gated request, e.g.
#   gate {"decision":"local-block","method":"GET","path":"/","country":"RU",
#         "asn":null,"ua":"Mozilla/5.0 (compatible; Googlebot/2.1)",...}
#   decisions: local-block, mgc-unavailable, mgc-ban-safe-url, mgc-ban-empty,
#              self-redirect-offer, self-redirect-white, offer-redirect, include-white
# Leave unset in production unless you are actively monitoring — it logs every request.
TRAFFIC_DEBUG=
# GATE_HOSTS=iptvnord4k.site,www.iptvnord4k.site
#   Hostnames the traffic gate applies to. Everything else — the payment
#   subdomain (pay.iptvnord4k.com, which serves /tv checkout), preview
#   deployments, localhost — reaches the app untouched.
GATE_HOSTS=
# GATE_MGC_FAILURE=store | offer | 503
#   What to serve when MagicChecker cannot be reached (network error, timeout
#   after 10s, non-200, or a response without success:1).
#   store (default) — the white page. Unclassifiable traffic never reaches the
#                     offer, and the site stays up. Costs conversions while the
#                     third party is down.
#   offer           — protect revenue instead: everything the gate could not
#                     classify is forwarded to OFFER_URL. Only safe if you
#                     accept that a crawler may see the offer during an outage.
#  503              — the original PHP behaviour: every visitor gets a 503,
#                     the property is effectively down with MagicChecker.
#   Any unrecognised value is treated as store.
GATE_MGC_FAILURE=
